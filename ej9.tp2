Algoritmo sin_titulo
	
	Escribir "ingresar un numero del 1 al 7"
	Leer a
	
	Segun a Hacer
		1:
			Escribir "lunes"
		2:
			Escribir "martes"
		3:
			Escribir "miercoles"
			
		4:
		    Escribir "jueves"
		5:
			Escribir "viernes"
		6:
			Escribir "sabado"
			
	    7:
		    Escribir "domingo"
			
		De Otro Modo:
			Escribir "Eror"
	Fin Segun
FinAlgoritmo
