Algoritmo sin_titulo
	Escribir "ingresar la primera nota"
	Leer a
	Escribir "ingresar la segunda nota"
	Leer b
	Escribir "ingresar tercera nota"
	Leer c
	promedio = (a+b+c)/3

	
	Si promedio > 6 Entonces
		escribir "aprobado"
	SiNo
		Escribir "desaprobado"
	Fin Si
	
	

FinAlgoritmo
